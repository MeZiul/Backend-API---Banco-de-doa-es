{
  "name": "backend-api-banco-de-doacoes",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "predev": "npm run prisma:generate",
    "dev": "nodemon server.js",
    "prestart": "npm run prisma:generate",
    "start": "node server.js",
    "pretest": "npm run prisma:generate",
    "test": "cross-env NODE_ENV=test BETTER_AUTH_SECRET=doai-test-secret-not-for-production-2026 jest --detectOpenHandles",
    "pretest:coverage": "npm run prisma:generate",
    "test:coverage": "cross-env NODE_ENV=test BETTER_AUTH_SECRET=doai-test-secret-not-for-production-2026 jest --coverage --detectOpenHandles",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "seed": "node src/seeds/seedDoaI.js",
    "check:migration": "node scripts/validate-migration-static.mjs",
    "pretest:db": "npm run prisma:generate",
    "test:db": "cross-env NODE_ENV=test node scripts/prisma-smoke.js",
    "test:auth:migration": "cross-env NODE_ENV=test node scripts/better-auth-migration-smoke.js",
    "pretest:auth": "npm run prisma:generate",
    "test:auth": "cross-env NODE_ENV=test BETTER_AUTH_SECRET=doai-test-secret-not-for-production-2026 node scripts/better-auth-smoke.js",
    "pretest:auth:http": "npm run prisma:generate",
    "test:auth:http": "cross-env NODE_ENV=test BETTER_AUTH_SECRET=doai-test-secret-not-for-production-2026 node scripts/better-auth-http-smoke.js",
    "test:compat": "node --test scripts/prisma-compat.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@gitlab.fslab.dev:6666/f-brica-de-software-i-2026-1/banco-de-doa-es/backend-api-banco-de-doacoes.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@babel/plugin-syntax-top-level-await": "^7.14.5",
    "@better-auth/prisma-adapter": "1.7.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.59.0",
    "@opentelemetry/exporter-jaeger": "^2.0.1",
    "@opentelemetry/resources": "^2.0.1",
    "@opentelemetry/sdk-node": "^0.201.1",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "babel-plugin-top-level-await": "^0.7.1",
    "bcryptjs": "^3.0.2",
    "better-auth": "1.7.1",
    "chai": "^5.2.0",
    "compression": "^1.8.0",
    "convert-csv-to-json": "^3.4.0",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-fileupload": "^1.5.1",
    "express-rate-limit": "^8.3.0",
    "faker-br": "^0.4.1",
    "firebase-admin": "^13.7.0",
    "google-auth-library": "^9.15.1",
    "helmet": "^8.1.0",
    "i18n": "^0.15.1",
    "jose": "6.2.3",
    "lodash": "^4.17.23",
    "moment-timezone": "^0.5.48",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.3",
    "nodemon": "^3.1.14",
    "path": "^0.12.7",
    "pg": "^8.16.3",
    "sharp": "^0.34.1",
    "sinon": "^21.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "4.4.3",
    "zod-to-json-schema": "^3.25.1",
    "zod-v3": "npm:zod@3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/preset-env": "^7.27.2",
    "@jest/globals": "^29.7.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-transform-import-meta": "^2.3.2",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "prisma": "7.9.1",
    "supertest": "^7.1.1"
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ],
    "plugins": [
      "babel-plugin-transform-import-meta"
    ]
  },
  "jest": {
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "testEnvironment": "node",
    "verbose": true,
    "transformIgnorePatterns": [
      "/node_modules/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "testMatch": [
      "<rootDir>/src/tests/**/*.spec.js"
    ],
    "testPathIgnorePatterns": [
      "<rootDir>/src/tests/test.js",
      "<rootDir>/aula-back-end-2026-1/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/aula-back-end-2026-1/"
    ],
    "moduleNameMapper": {
      "^\\.\\./middlewares/AuthMiddleware\\.js$": "<rootDir>/src/tests/mocks/AuthMiddleware.js",
      "^\\.\\./config/betterAuth\\.js$": "<rootDir>/src/tests/mocks/betterAuth.js",
      "^better-auth/node$": "<rootDir>/src/tests/mocks/betterAuthNode.js"
    },
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/utils/helpers/index.js",
      "/src/utils/logger.js",
      "/src/services/ImagemItemService.js"
    ]
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  }
}
