############################################
# Banco de dados - PostgreSQL + Prisma
############################################
# Ao executar a API no host (npm run dev), use localhost.
DATABASE_URL="postgresql://doai:doai_local@localhost:5432/doai?schema=public"
# Banco separado para testes de integração, se usado.
TEST_DATABASE_URL="postgresql://doai:doai_local@localhost:5433/doai_test?schema=public"
# Opcional: exibe queries do Prisma no log.
PRISMA_QUERY_LOG=false

############################################
# Servidor
############################################
APP_PORT=7340
API_HOST_PORT=7340
TRUST_PROXY_HOPS=0
NODE_ENV=development
# SWAGGER_DEV_URL=http://localhost:7340
# SWAGGER_PROD_URL=https://api.exemplo.com

############################################
# Better Auth
############################################
# Gere um segredo aleatório exclusivo com pelo menos 32 caracteres.
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres
BETTER_AUTH_URL=http://localhost:7340
# Lista separada por vírgulas, sem caminhos.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:7340

############################################
# Firebase App Check (opcional em dev)
############################################
FIREBASE_PROJECT_ID=
APP_CHECK_ENABLED=false

############################################
# Conta criada pelo seed
############################################
ADMIN_EMAIL=admin@doai.com
ADMIN_SENHA=Admin@123
ADMIN_NOME=Administrador DoaI

############################################
# E-mail
############################################
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_FROM=
EMAIL_PASS=
EMAIL_SECURE=false
DISABLED_EMAIL=true
FRONTEND_URL=http://localhost:5173
BASE_URL=http://localhost:7340
MAIL_API_KEY=
MAIL_API_URL=
COMPANY_NAME=DoaI

############################################
# Logs / documentação
############################################
LOG_LEVEL=info
LOG_MAX_SIZE_GB=1
LOG_ENABLED=true
DEBUGLOG=false
DISABLE_SWAGGER_AUTO_GENERATE=false
