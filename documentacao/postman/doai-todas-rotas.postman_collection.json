    {
      "name": "01 - Autenticacao",
      "item": [
        {
          "name": "Login usuario comum",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token;",
                  "const usuario = json?.data?.usuario;",
                  "if (token) {",
                  "  pm.collectionVariables.set('userToken', token);",
                  "  pm.collectionVariables.set('beneficiadoToken', token);",
                  "}",
                  "if (usuario?._id) pm.collectionVariables.set('usuarioId', usuario._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"senha\": \"{{senhaPadrao}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/login" }
          }
        },
        {
          "name": "Login beneficiado",
          "event": [
