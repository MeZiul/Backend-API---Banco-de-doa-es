  "item": [
    {
      "name": "Apresentacao",
      "description": "Execute em ordem. Os scripts em Tests preenchem categoriaId, joaoToken, anaToken, itemId e interesseId automaticamente.",
      "item": [
        {
          "name": "0 - Preparar categoria para o item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json?.data;",
                  "const docs = Array.isArray(data) ? data : (data?.docs || []);",
                  "const first = docs[0];",
                  "if (first?._id) pm.collectionVariables.set('categoriaId', first._id);",
                  "pm.test('categoriaId preenchido', function () { pm.expect(pm.collectionVariables.get('categoriaId')).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/categorias?page=1&limite=10"
            }
          },
          "response": []
        },
        {
          "name": "1 - Login como Joao (doador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token;",
                  "const usuario = json?.data?.usuario;",
                  "if (token) pm.collectionVariables.set('joaoToken', token);",
                  "if (usuario?._id) pm.collectionVariables.set('joaoId', usuario._id);",
                  "pm.test(\"login retornou token\", function () { pm.expect(token).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{joaoEmail}}\",\n  \"senha\": \"{{senhaPadrao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            }
          },
          "response": []
        },
        {
          "name": "2 - Joao cria item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?._id;",
                  "if (id) pm.collectionVariables.set('itemId', id);",
                  "pm.test('itemId preenchido', function () { pm.expect(pm.collectionVariables.get('itemId')).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{joaoToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Bicicleta infantil aro 16\",\n  \"descricao\": \"Bicicleta com rodinhas em otimo estado.\",\n  \"categoria_id\": \"{{categoriaId}}\",\n  \"condicao_item\": \"USADO_BOM\",\n  \"cidade\": \"Rio Branco\",\n  \"uf\": \"AC\",\n  \"bairro\": \"Centro\",\n  \"condicoes_doacao\": \"Retirada combinada pelo chat.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/itemdoacao"
            }
          },
          "response": []
        },
        {
          "name": "3 - Verificar item publico",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/itemdoacao/{{itemId}}"
            }
          },
          "response": []
        },
        {
          "name": "4 - Login como Ana (interessada)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token;",
                  "const usuario = json?.data?.usuario;",
                  "if (token) pm.collectionVariables.set('anaToken', token);",
                  "if (usuario?._id) pm.collectionVariables.set('anaId', usuario._id);",
                  "pm.test(\"login retornou token\", function () { pm.expect(token).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{anaEmail}}\",\n  \"senha\": \"{{senhaPadrao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login"
            }
          },
          "response": []
        },
        {
          "name": "5 - Ana manifesta interesse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const id = json?.data?._id;",
                  "if (id) pm.collectionVariables.set('interesseId', id);",
                  "pm.test('interesseId preenchido', function () { pm.expect(pm.collectionVariables.get('interesseId')).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"item_id\": \"{{itemId}}\",\n  \"mensagem_interessado\": \"Tenho interesse nessa bicicleta e posso retirar ainda hoje.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/interesses"
            }
          },
          "response": []
        },
        {
          "name": "6 - Joao lista interesses recebidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json?.data;",
                  "const docs = Array.isArray(data) ? data : (data?.docs || []);",
                  "const currentItemId = pm.collectionVariables.get(\"itemId\");",
                  "const match = docs.find((i) => {",
                  "  const item = i.item_id?._id || i.item_id;",
                  "  return String(item) === String(currentItemId);",
                  "}) || docs[0];",
                  "if (match?._id) pm.collectionVariables.set(\"interesseId\", match._id);",
                  "pm.test(\"interesse recebido salvo\", function () { pm.expect(pm.collectionVariables.get(\"interesseId\")).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{joaoToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/interesses/recebidos?page=1&limite=10"
            }
          },
          "response": []
        },
        {
          "name": "7 - Joao aceita o interesse",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{joaoToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mensagemResposta\": \"Pode retirar amanha no periodo da tarde.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/interesses/{{interesseId}}/aceitar"
            }
          },
          "response": []
        },
        {
          "name": "8 - Verificar item reservado",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/itemdoacao/{{itemId}}"
            }
          },
          "response": []
        },
        {
          "name": "9 - Joao confirma entrega",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{joaoToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/itemdoacao/{{itemId}}/confirmar-entrega"
            }
          },
          "response": []
        },
        {
          "name": "10 - Ana confirma recebimento",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{anaToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/itemdoacao/{{itemId}}/confirmar-recebimento"
            }
          },
          "response": []
        }
      ]
    }
  ]
}
