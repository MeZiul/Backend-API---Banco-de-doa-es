  "item": [
    {
      "name": "Apresentacao - API Online",
      "description": "Execute em ordem. A collection usa a API online e preenche automaticamente tokens e IDs. A categoria e buscada automaticamente no pre-request da criacao do item, com fallback para uma categoria online existente.",
      "item": [
        {
          "name": "01 - Login como Joao (doador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token;",
                  "const usuario = json?.data?.usuario || json?.usuario;",
                  "if (token) pm.collectionVariables.set('joaoToken', token);",
                  "if (usuario?._id) pm.collectionVariables.set('joaoId', usuario._id);",
                  "pm.test('login do Joao retornou token', function () { pm.expect(token).to.be.ok; });",
                  "pm.test('joaoId preenchido', function () { pm.expect(pm.collectionVariables.get('joaoId')).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{joaoEmail}}\",\n  \"senha\": \"{{senhaPadrao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "https://api.doai.fs.fslab.dev/auth/login",
              "protocol": "https",
              "host": [
                "api",
                "doai",
                "fs",
                "fslab",
                "dev"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "02 - Joao cria item",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "if (!pm.collectionVariables.get('categoriaId')) {",
                  "  pm.collectionVariables.set('categoriaId', '6a2b3f17f5dd53be61d6fab8');",
                  "}",
                  "pm.sendRequest(`${baseUrl}/categorias?page=1&limite=10`, function (err, res) {",
                  "  if (err || !res) return;",
                  "  const json = res.json();",
                  "  const data = json?.data;",
                  "  const docs = Array.isArray(data) ? data : (data?.docs || []);",
                  "  const brinquedos = docs.find((categoria) => String(categoria?.nome || '').toLowerCase().includes('brinqu'));",
                  "  const categoria = brinquedos || docs[0];",
                  "  if (categoria?._id) pm.collectionVariables.set('categoriaId', categoria._id);",
                  "});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const item = json?.data;",
                  "if (item?._id) pm.collectionVariables.set('itemId', item._id);",
                  "if (item?.categoria_id?._id) pm.collectionVariables.set('categoriaId', item.categoria_id._id);",
                  "pm.test('item criado com sucesso', function () { pm.expect(pm.response.code).to.be.oneOf([200, 201]); });",
                  "pm.test('itemId preenchido', function () { pm.expect(pm.collectionVariables.get('itemId')).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{joaoToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Bicicleta infantil aro 16 - {{$timestamp}}\",\n  \"descricao\": \"Bicicleta com rodinhas em otimo estado para demonstracao do fluxo principal.\",\n  \"categoria_id\": \"{{categoriaId}}\",\n  \"condicao_item\": \"USADO_BOM\",\n  \"cidade\": \"Rio Branco\",\n  \"uf\": \"AC\",\n  \"bairro\": \"Centro\",\n  \"condicoes_doacao\": \"Retirada combinada pelo chat.\"\n}",
              "options": {
