        {
          "name": "02 - Listar categorias e guardar categoriaId",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.doai.fs.fslab.dev/categorias?ativo=true&page=1&limite=100",
              "protocol": "https",
              "host": [
                "api",
                "doai",
                "fs",
                "fslab",
                "dev"
              ],
              "path": [
                "categorias"
              ],
              "query": [
                {
                  "key": "ativo",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limite",
                  "value": "100"
                }
              ]
            },
            "description": "Seleciona uma categoria ativa e salva seu ID; não usa IDs fixos de MongoDB."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const responseData = json?.data;",
                  "const docs = Array.isArray(responseData) ? responseData : (responseData?.docs || []);",
                  "const brinquedos = docs.find((categoria) => String(categoria?.nome || '').toLowerCase().includes('brinqu'));",
                  "const categoria = brinquedos || docs.find((item) => item?.ativo !== false) || docs[0];",
                  "if (categoria?._id) pm.collectionVariables.set('categoriaId', categoria._id);",
                  "pm.test('categorias retornadas', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('categoriaId preenchido', function () { pm.expect(pm.collectionVariables.get('categoriaId')).to.be.ok; });"
                ]
              }
            }
          ]
        },
        {
