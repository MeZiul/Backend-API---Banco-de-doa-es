      "item": [
        {
          "name": "00 - Verificar API e Swagger JSON",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://api.doai.fs.fslab.dev/docs.json",
              "protocol": "https",
              "host": [
                "api",
                "doai",
                "fs",
                "fslab",
                "dev"
              ],
              "path": [
                "docs.json"
              ]
            },
            "description": "Confirma que a API pública e a documentação OpenAPI estão acessíveis antes da demonstração."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test('API publica respondeu 200', function () { pm.expect(pm.response.code).to.eql(200); });",
                  "pm.test('documento OpenAPI carregado', function () { pm.expect(json?.openapi).to.match(/^3\\./); });"
                ]
              }
            }
          ]
        },
        {
          "name": "01 - Login como Joao (doador)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "const token = json?.data?.token || json?.token;",
                  "const usuario = json?.data?.usuario || json?.usuario;",
                  "if (token) pm.collectionVariables.set('joaoToken', token);",
                  "if (usuario?._id) pm.collectionVariables.set('joaoId', usuario._id);",
                  "pm.test('login do Joao retornou token', function () { pm.expect(token).to.be.ok; });",
                  "pm.test('joaoId preenchido', function () { pm.expect(pm.collectionVariables.get('joaoId')).to.be.ok; });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{joaoEmail}}\",\n  \"senha\": \"{{senhaPadrao}}\"\n}",
              "options": {
